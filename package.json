{
  "name": "akoka-monorepo",
  "private": true,
  "description": "AKOKA - Campus Price Intelligence & Protected Commerce (UNILAG)",
  "scripts": {
    "dev:backend": "npm run dev --prefix akoka-backend",
    "dev:frontend": "npm run dev --prefix akoka-frontend",
    "build:backend": "npm run build --prefix akoka-backend",
    "build:frontend": "npm run build --prefix akoka-frontend",
    "seed:backend": "npm run seed --prefix akoka-backend",
    "deploy:backend": "cd akoka-backend && vercel",
    "deploy:frontend": "cd akoka-frontend && vercel",
    "deploy:backend:prod": "cd akoka-backend && vercel --prod",
    "deploy:frontend:prod": "cd akoka-frontend && vercel --prod"
  }
}
